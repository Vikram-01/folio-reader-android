<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Cleartext HTTP is refused for the whole app; only system CAs are
     trusted (user-installed CAs are not), which blocks most interception proxies. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

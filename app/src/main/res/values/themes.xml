<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Folio" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/folio_paper</item>
    </style>

    <style name="Theme.Folio.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/folio_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Folio</item>
    </style>
</resources>
